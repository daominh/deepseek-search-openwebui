# DeepSeek tools API base URL, without the tool suffix (/tools/search, /tools/fetch are appended)
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
# Optional: upstream timeouts in seconds (default 30)
# SEARCH_TIMEOUT=30
# FETCH_TIMEOUT=30
# Optional: undo DeepSeek's over-escaped markdown punctuation in fetched pages (default true)
# FETCH_UNESCAPE_MARKDOWN=true
